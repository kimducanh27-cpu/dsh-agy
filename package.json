{
  "name": "dsh-subagent-antigravity",
  "version": "0.2.1-rc.5",
  "private": true,
  "description": "One-shot Antigravity subagent provider over the Antigravity CLI headless protocol",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/seam.js",
    "lib/wire.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/agy-task.mjs",
    "AGENTS.md",
    "DELEGATION.md",
    "prompts/*.md",
    "README.md",
    "README.vi.md"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimducanh27-cpu/dsh-agy.git"
  },
  "homepage": "https://github.com/kimducanh27-cpu/dsh-agy#readme",
  "bugs": {
    "url": "https://github.com/kimducanh27-cpu/dsh-agy/issues"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test test/wire.test.mjs test/provider.test.mjs test/seam.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
